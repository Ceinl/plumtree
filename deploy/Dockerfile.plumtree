FROM golang:1.26.5-alpine3.24 AS build
WORKDIR /src
RUN apk add --no-cache gcc musl-dev
COPY . .
RUN CGO_ENABLED=1 go build -trimpath -o /out/plumtree ./cmd/plumtree
RUN CGO_ENABLED=1 go build -trimpath -o /out/runner-worker ./cmd/runner-worker

FROM alpine:3.24.1
RUN adduser -D -u 65532 plumtree \
    && mkdir -p /data /run/plumtree /run/plumtree-sessions \
    && chown plumtree /data /run/plumtree /run/plumtree-sessions
COPY --from=build /out/plumtree /usr/local/bin/plumtree
COPY --from=build /out/runner-worker /usr/local/bin/runner-worker
COPY --chown=plumtree:plumtree --chmod=0600 config.example.json /etc/plumtree/config.json
USER plumtree
ENV HOME=/data
VOLUME /data
EXPOSE 2222
ENTRYPOINT ["plumtree"]
