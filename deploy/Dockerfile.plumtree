FROM golang:1.26.5-alpine3.24 AS build
WORKDIR /src
RUN apk add --no-cache bash gcc musl-dev openssl-dev sqlcipher-dev
COPY . .
RUN SQLCIPHER_PREFIX=/usr \
    SQLCIPHER_INCLUDE=/usr/include/sqlcipher \
    SQLCIPHER_LIBRARY=sqlcipher \
    OPENSSL_PREFIX=/usr \
    CC=gcc \
    ./scripts/build-native-release.sh /out

FROM alpine:3.24.1
RUN apk add --no-cache sqlcipher-libs \
    && adduser -D -u 65532 plumtree \
    && mkdir -p /data \
    && chown plumtree /data
COPY --from=build /out/plumtree /usr/local/bin/plumtree
COPY --from=build /out/runner-worker /usr/local/bin/runner-worker
COPY --chown=plumtree:plumtree --chmod=0600 config.example.json /etc/plumtree/config.json
USER plumtree
ENV HOME=/data
VOLUME /data
EXPOSE 2222
ENTRYPOINT ["plumtree"]
